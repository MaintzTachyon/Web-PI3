# Variables del stack local (infra/local/docker-compose.yml).
# Copiar a .env antes de levantar el stack: cp .env.example .env
# No subir el .env real al repositorio.

# Contraseña del usuario admin de InfluxDB.
INFLUX_PASSWORD=cambia-esta-contrasena

# Token de administrador que InfluxDB crea en el primer arranque y que usa
# Telegraf para escribir. Para el backend conviene generar después un token
# de solo lectura sobre el bucket "gemelo".
INFLUX_TOKEN=cambia-este-token

# Contraseña del usuario admin de Grafana.
GRAFANA_PASSWORD=cambia-esta-contrasena
